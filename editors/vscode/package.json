{
  "name": "prufgate",
  "displayName": "PrufGate",
  "description": "Shows PrufGate findings (faked results, hollow tests, weakened checks) inline. Runs the prufgate CLI you install.",
  "version": "1.2.0",
  "publisher": "GuardianVigil",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/GuardianVigil-Labs/Prufgate"
  },
  "homepage": "https://github.com/GuardianVigil-Labs/Prufgate/tree/main/editors/vscode",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Linters"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "PrufGate runs a local program on the workspace, so it needs a trusted workspace."
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "prufgate.checkWorkspace",
        "title": "Check workspace",
        "category": "PrufGate"
      }
    ],
    "configuration": {
      "title": "PrufGate",
      "properties": {
        "prufgate.path": {
          "type": "string",
          "default": "prufgate",
          "scope": "machine",
          "markdownDescription": "The `prufgate` program to run: a command name looked up on `PATH`, or an absolute path. User or remote settings only, so a workspace cannot change it."
        },
        "prufgate.scope": {
          "type": "string",
          "enum": [
            "changed",
            "workspace"
          ],
          "enumDescriptions": [
            "Changed files only: `prufgate check --changed`.",
            "The whole workspace folder: `prufgate check`."
          ],
          "default": "changed",
          "scope": "machine",
          "markdownDescription": "What a check scans. User or remote settings only, so a workspace cannot change it."
        },
        "prufgate.runOnSave": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "Check again shortly after a file is saved. User or remote settings only, so a workspace cannot switch it off."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "tsc -p . && node --test out/test/",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "tsc -p . && node -e \"require('fs').copyFileSync('../../LICENSE', 'LICENSE')\"",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "7.0.2"
  }
}
